# Pinterest Login Credentials (required if session state doesn't exist)
PINTEREST_EMAIL=your_pinterest_email@example.com
PINTEREST_PASSWORD=your_pinterest_password

# Optional runtime overrides
# PGA_BROWSER_MODE can be gui or headless. Leave blank to use config.yaml.
PGA_BROWSER_MODE=
PROXY_URL=

# Text AI providers
# Add only the keys for providers you enable in config.yaml.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=
# Used for OpenAI text and OpenAI image generation.
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
HF_API_KEY=

# Local AI endpoints usually do not need API keys.
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# Image provider keys
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
